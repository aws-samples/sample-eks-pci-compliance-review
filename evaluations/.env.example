# Example environment for running the reviewing-pci-compliance-in-aws-eks
# evaluation suite. Copy to `.env` and fill in your values:
#
#   cp .env.example .env
#
# `.env` is gitignored — never commit real values. These are read by the
# promptfoo run and by providers/strands_provider.py.

# --- AWS access (read-only) --------------------------------------------------
# Named CLI profile used for live eval runs. `pci-eval-ro` was set up to reuse
# the default credentials pinned to us-west-2. Swap to a least-privilege role
# profile (see evaluations/iam/) when available.
AWS_PROFILE=pci-eval-ro
AWS_REGION=us-west-2

# --- Target EKS cluster (live tests) -----------------------------------------
# The read-only cluster the live (metadata.live=true) tests grade against.
# kubectl context must already point at this cluster.
EVAL_CLUSTER_NAME=your-cluster-name
EVAL_CLUSTER_REGION=us-west-2

# --- Model / grader access ---------------------------------------------------
# Bedrock is used for the agent-under-test and the llm-rubric judge. Ensure the
# model IDs in promptfooconfig.yaml are enabled in this account/region.
# If you run GPT agents, set OPENAI_API_KEY as well.
# OPENAI_API_KEY=sk-...

# --- promptfoo behavior ------------------------------------------------------
# Set to 1 to short-circuit the real agent for offline routing checks only.
# Leave unset for real (baseline vs skill) runs.
# PROMPTFOO_STUB_AGENT=1
PROMPTFOO_DISABLE_TELEMETRY=1
